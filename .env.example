# 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ── API 密钥 ──────────────────────────────────────────
OPENAI_API_KEY=your_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here
# MINIMAX_API_KEY=your_minimax_key_here

# ── 数据库配置 ────────────────────────────────────────
# PostgreSQL 连接串（覆盖 config.yaml 中的 database.postgres 配置）
# PAPER_AGENT_DB_DSN=postgresql://postgres:postgres@localhost:5432/paper_agent

# Qdrant 向量数据库
# QDRANT_HOST=localhost
# QDRANT_PORT=6333

# ── 代理配置（可选）────────────────────────────────────
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# ── 日志 ──────────────────────────────────────────────
LOG_LEVEL=INFO

# ── LLM 配置 ──────────────────────────────────────────
# 以下值覆盖 config.yaml 中的 llm 段
# LLM_PROVIDER=openai
# LLM_MODEL=minimax
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=4096

# ── 性能 ──────────────────────────────────────────────
# PDF 下载/解析的并行工作线程数
# PARALLEL_WORKERS=4
