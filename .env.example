# 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# API密钥配置
OPENAI_API_KEY=your_api_key_here

# 代理配置（可选）
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# 日志级别
LOG_LEVEL=INFO

# 缓存配置
CACHE_TTL=3600
ENABLE_CACHE=true

# 并发配置
MAX_CONCURRENT=10

# LLM配置
LLM_PROVIDER=openai
LLM_MODEL=minimax
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# ── 并行配置 ──────────────────────────────────────────
# PDF 下载/解析的并行工作线程数
# PARALLEL_WORKERS=4

# ── Qdrant 向量存储配置 ──────────────────────────────
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
